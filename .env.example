# Copy to .env and fill in real values.
# For production values, see .env.production.example.

# HTTP port
PORT=3000

# development | production | test
NODE_ENV=development

# MongoDB connection string
# Development must point at the sandbox database, not "crumbs".
# The app refuses to start otherwise, so this is a hard requirement.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/crumbs_dev?appName=Crumbs

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origin allowed to call this API from a browser. Should match the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# Which timezone decides what "today" is (for "3 days left", overdue flags...).
# Use an IANA name, e.g. Asia/Manila. Defaults to UTC if left out.
APP_TIMEZONE=Asia/Manila

# Folder where uploaded event images are stored. Defaults to ./uploads
# UPLOAD_DIR=
