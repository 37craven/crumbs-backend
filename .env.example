# Copy to .env and fill in real values.
# For production values, see .env.production.example.

# HTTP port
PORT=3000

# development | production | test
NODE_ENV=development

# MongoDB connection string
# Development must point at the sandbox database, not "crumbs".
# The app refuses to start otherwise, so this is a hard requirement.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/crumbs_dev?appName=Crumbs

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origin allowed to call this API from a browser. Should match the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# Which timezone decides what "today" is (for "3 days left", overdue flags...).
# Use an IANA name, e.g. Asia/Manila. Defaults to UTC if left out.
APP_TIMEZONE=Asia/Manila

# Folder where uploaded images are stored: collection pictures, crumbs and
# profile photos. Defaults to ./uploads
# UPLOAD_DIR=

# ---- Email (SMTP) -----------------------------------------------------------
# Mail is optional. With no SMTP_HOST set the app runs and PRINTS messages to
# the console instead of sending them, so nothing is blocked while you set this
# up. Copy the values your provider gives you.
#
#   Gmail / Workspace : smtp.gmail.com       587   (app password, not your account password)
#   Outlook / Hotmail : smtp.office365.com   587
#   Yahoo             : smtp.mail.yahoo.com  587
#   Mailgun           : smtp.mailgun.org     587
#   MailHog (local)   : localhost            1025

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false

# The account you authenticate as. Usually the same address you receive mail on.
# SMTP_USER=
# SMTP_PASSWORD=

# The "from" on outgoing mail. Some providers insist it matches SMTP_USER.
# MAIL_FROM=Crumbs <no-reply@yourdomain.com>

# Where the links inside emails point: the WEB CLIENT, not the API. Defaults to
# CLIENT_ORIGIN, which is right in development.
# PUBLIC_URL=http://localhost:5173
