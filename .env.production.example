# Production environment template. Not committed — see .env.example for local dev.
#
# Set these in the Vercel project's Production environment instead of committing
# a .env file. The preview environment uses the same keys with crumbs_preview.

# Must be "production" for the startup guard to allow the live database.
NODE_ENV=production

PORT=3000

# Must point at the live "crumbs" database, not crumbs_dev.
MONGODB_URI=mongodb+srv://<prod-user>:<password>@<cluster-host>/crumbs?appName=Crumbs

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=7d

# Must be the deployed frontend origin. Cookies are marked secure in
# production, so this must be served over HTTPS.
CLIENT_ORIGIN=https://crumbs.vercel.app

# Where links inside verification and reset emails point.
PUBLIC_URL=https://crumbs.vercel.app
